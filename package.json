{
  "name": "spec-to-mask-quest",
  "private": true,
  "description": "Photonic IC design learning game (SPEC-to-MASK Quest)",
  "scripts": {
    "build": "sh tools/build.sh",
    "tables": "python3 tools/build_data.py",
    "calibrate": "node tools/calibrate.js",
    "test:smoke": "node test/e2e/smoke.js si1310",
    "test:bot": "node test/e2e/bot.js std 2 1-1,1-2,1-3,1-4,1-5,1-6,1-7,2-1,2-2,2-3,2-3R,2-4,2-5,3A,3A+,3W,D-1,D-2,B-1,B-2,B-3 si1310",
    "test:migrate": "node test/e2e/migrate.js",
    "test:export": "node test/e2e/export.js all",
    "test:py": "cd tools && python ../test/py/test_smq2gds.py && python ../test/py/test_circuit.py",
    "test:upgrade": "node test/t_upgrade.js",
    "test:flow": "node test/e2e/flow.js si1310 && node test/e2e/flow.js si1550 && node test/e2e/flow.js sin1310 && node test/e2e/flow.js sin1550",
    "test:guide": "node test/e2e/guide.js si1310 && node test/e2e/guide.js sin1550",
    "test:mrr": "node test/t_mrr.js",
    "test:dr8": "node test/t_dr8.js",
    "test:wdm": "node test/t_wdm.js",
    "test:baseline": "node test/t_baseline.js",
    "test:lab": "node test/t_lab.js && node test/e2e/lab.js si1310 && node test/e2e/lab.js sin1550 && node test/e2e/lab_state.js si1310 && node test/e2e/lab_state.js sin1550",
    "build:offline": "SMQ_OFFLINE=1 sh tools/build.sh dist/index-offline.html",
    "test:backup": "node test/e2e/backup.js",
    "test:fab": "node test/e2e/fab.js si1310",
    "test:learn": "node test/e2e/learn.js",
    "release": "sh tools/release.sh",
    "test:syntax": "node tools/check_syntax.js",
    "probe:dir": "node test/e2e/bot_dir.js",
    "test:wipe": "node test/e2e/wipe.js si1310 && node test/e2e/wipe.js sin1550",
    "test:studio": "node test/e2e/studio_state.js",
    "test:browser": "node test/browser/studio.js",
    "test:mzm-bench": "node test/t_mzm_bench.js",
    "test:browser:mzm": "node test/browser/mzm_bench.js",
    "test:v2": "node test/t_v2.js",
    "test:browser:v2": "node test/browser/v2.js"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "playwright": "^1.62.1"
  },
  "version": "2.0.0-alpha.1-p1"
}
